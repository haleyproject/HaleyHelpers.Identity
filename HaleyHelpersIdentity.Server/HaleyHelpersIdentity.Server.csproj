<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><AssemblyName>Haley.Helpers.Identity.Server</AssemblyName><PackageId>Haley.Helpers.Identity.Server</PackageId><IsPackable>true</IsPackable><Version Condition="'$(HaleyHelpersIdentityServerVersion)' != ''">$(HaleyHelpersIdentityServerVersion)</Version></PropertyGroup>
<ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
<ItemGroup><ProjectReference Include="../HaleyHelpersIdentity/HaleyHelpersIdentity.csproj" /></ItemGroup>
<Choose><When Condition="'$(HaleyIdentityUseSourceReferences)' == 'true'"><ItemGroup><ProjectReference Include="$(HaleyProject)/HaleyHelpers.Web/HaleyHelpersWeb/HaleyHelpersWeb.csproj" /></ItemGroup></When><Otherwise><ItemGroup><PackageReference Include="Haley.Helpers.Web" Version="0.2.12" /></ItemGroup></Otherwise></Choose>
<Choose><When Condition="'$(HaleyIdentityUseSourceReferences)' == 'true'"><ItemGroup><ProjectReference Include="$(HaleyProject)/HaleyHelpers.DB/HaleyHelpersDB/HaleyHelpersDB.csproj" /></ItemGroup></When><Otherwise><ItemGroup><PackageReference Include="Haley.Helpers.DB" Version="0.1.16" /></ItemGroup></Otherwise></Choose>

  <Import Project="Database/Database.Source.props" />
<PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(HaleyProject)\HaleyProject\HaleyProject.snk</AssemblyOriginatorKeyFile>
    <Authors>The Haley Project</Authors>
    <Company>TheHaleyProject</Company>
    <Copyright>Haley</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Haley.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/haleyproject/HaleyHelpers.Identity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/haleyproject/HaleyHelpers.Identity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Debug'">false</GeneratePackageOnBuild>
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PackageReleaseNotes>Initial embedded identity engine, MariaDB persistence, MFA, opaque sessions and shared HTTP endpoints.</PackageReleaseNotes>
    <Description>Reusable accounts, credentials, MFA and opaque sessions with embedded or remote access.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(HaleyProject)\HaleyProject\Haley.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
