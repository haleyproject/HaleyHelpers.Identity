<Project Sdk="Microsoft.NET.Sdk.Web">
<PropertyGroup><AssemblyName>Haley.Identity.Host</AssemblyName><PackageId>Haley.Identity.Host</PackageId><IsPackable>false</IsPackable></PropertyGroup>
<ItemGroup><ProjectReference Include="../HaleyHelpersIdentity.Server/HaleyHelpersIdentity.Server.csproj" /></ItemGroup>
<ItemGroup><Content Remove="wwwroot/admin/**/*" /></ItemGroup>

<ItemGroup><None Update="*.container;podman.cfile" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="BuildIdentityAdminForPublish" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../HaleyIdentityAdmin.Web" Command="npm ci --no-audit --no-fund" Condition="'$(SkipIdentityAdminBuild)' != 'true'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../HaleyIdentityAdmin.Web" Command="npm run build" Condition="'$(SkipIdentityAdminBuild)' != 'true'" />
    <ItemGroup>
      <IdentityAdminDist Include="$(MSBuildProjectDirectory)/wwwroot/admin/**/*" />
      <ResolvedFileToPublish Include="@(IdentityAdminDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/admin/%(IdentityAdminDist.RecursiveDir)%(IdentityAdminDist.Filename)%(IdentityAdminDist.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
